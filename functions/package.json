{
  "name": "cinemotes-ledger-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:provision": "node scripts/provision-admin.mjs",
    "test": "node --test",
    "dev": "node --use-system-ca ./node_modules/wrangler/bin/wrangler.js dev --config wrangler.local.jsonc",
    "db:sql": "wrangler d1 execute DB --local --config wrangler.local.jsonc",
    "db:migration": "wrangler d1 migrations create DB --config wrangler.local.jsonc",
    "db:migrate": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "db:export": "wrangler d1 export DB --local --config wrangler.local.jsonc",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "wrangler": "^4.150.0"
  }
}
